# Local credentials for the opt-in graphrag-real-providers Maven profile.
# Copy is created by make bootstrap-real-providers and is ignored by Git.
# Do not commit provider endpoints, API keys, models or dimensions.

# Azure OpenAI-compatible base URL: https://{resource}.openai.azure.com/openai/v1/.
# A legacy /openai/deployments/{deployment}/embeddings?... URL is also accepted and normalized.
GRAPHRAG_EMBEDDING_API_URL=
GRAPHRAG_EMBEDDING_API_KEY=
# Empty values are derived from Azure /openai/deployments/{deployment-id}/ endpoints when possible.
GRAPHRAG_EMBEDDING_MODEL=
GRAPHRAG_EMBEDDING_DIMENSION=
OPENAI_API_URL=
OPENAI_API_KEY=
GRAPHRAG_CHAT_MODEL=