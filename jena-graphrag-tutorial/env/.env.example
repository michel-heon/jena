# Apache Jena release installed by the procedure in docs/getting-started.md.
# Keep this version aligned with https://jena.apache.org/download/.
JENA_VERSION=6.2.0

# Absolute, writable parent directory for the Jena CLI and Fuseki distributions.
# Example: /home/alice/.local/share/apache-jena
# The installation procedure derives the following paths from this value:
#   JENA_HOME=$JENA_INSTALL_DIR/apache-jena-$JENA_VERSION
#   FUSEKI_HOME=$JENA_INSTALL_DIR/apache-jena-fuseki-$JENA_VERSION
#   FUSEKI_BASE=$JENA_INSTALL_DIR/fuseki-base
JENA_INSTALL_DIR=

# Base URL of the Fuseki server used by the tutorial, without a trailing slash.
# It may name a remote Fuseki instance. For the locally managed server, use an
# available local HTTP port and keep FUSEKI_MANAGED_LOCALLY=true.
FUSEKI_URL=http://127.0.0.1:3030
FUSEKI_MANAGED_LOCALLY=true

# JVM arguments for the Fuseki process started by the tutorial. Tune heap sizes
# for the host and workload; for example: -Xms1G -Xmx4G. Ignored for remote
# Fuseki because that server is managed in its own deployment.
FUSEKI_JAVA_OPTIONS=-Xmx4G

# Remote dataset creation is explicitly opt-in. Set both values only when
# FUSEKI_MANAGED_LOCALLY=false and the remote server grants admin access to
# POST /$/datasets. The Turtle file defines remote storage, GraphRAG indexes,
# and providers; its paths and environment variable names belong to the remote
# server, not this workstation.
FUSEKI_ALLOW_DATASET_CREATE=false
FUSEKI_REMOTE_DATASET_CONFIG=

# Optional path to a local curl configuration file for an authenticated remote
# Fuseki. The file is ignored by Git and can contain --netrc-file, TLS client
# certificate, or proxy options; never store credentials in FUSEKI_URL.
FUSEKI_CURL_CONFIG=

# Local GraphRAG runtime configuration. The bootstrap copies this template to
# env/.env, which is ignored by Git. Never commit provider credentials.

# OpenAI-compatible embedding endpoint, credential, model identifier and vector
# dimension. Indexing cannot run until these values match the selected provider.
GRAPHRAG_EMBEDDING_API_URL=
GRAPHRAG_EMBEDDING_API_KEY=
GRAPHRAG_EMBEDDING_MODEL=
GRAPHRAG_EMBEDDING_DIMENSION=

# Default retrieval mode and result limits exposed by the GraphRAG HTTP routes.
# Supported modes are basic, local, global and drift.
GRAPHRAG_DEFAULT_MODE=local
GRAPHRAG_DEFAULT_TOP_K=5
GRAPHRAG_MAX_TOP_K=100

# DRIFT traversal limits: number of primer communities, maximum follow-up
# iterations, total context budget and local results retrieved per iteration.
GRAPHRAG_DRIFT_COMMUNITY_TOP_K=5
GRAPHRAG_DRIFT_MAX_FOLLOW_UPS=3
GRAPHRAG_DRIFT_CONTEXT_TOKEN_BUDGET=4096
GRAPHRAG_DRIFT_LOCAL_TOP_K=1

# Maximum number of characters accepted from one resource during indexing.
GRAPHRAG_INDEX_MAX_CONTENT_LENGTH=1000000

# Tutorial paths are relative to jena-graphrag-tutorial/. The dataset value is
# used as the Fuseki dataset name and therefore becomes part of its HTTP URL.
GRAPHRAG_TUTORIAL_PDF_PATH=src/main/resources/corpus/ingestion/pdf
GRAPHRAG_TUTORIAL_CORPUS_PATH=data/pdf-corpus.ttl
GRAPHRAG_TUTORIAL_DATASET=graphrag-smoke

# Number of PDFs that make pdfs-check succeed for the configured corpus path.
GRAPHRAG_TUTORIAL_EXPECTED_PDF_COUNT=12

# RDF base URI and PDF ingestion limits. Chunk sizes and overlap are expressed
# in characters; the maximum file size is expressed in bytes (50 MiB here).
GRAPHRAG_INGESTION_BASE_URI=http://ormynet.com/ns/data#
GRAPHRAG_INGESTION_CHUNK_SIZE=1000
GRAPHRAG_INGESTION_CHUNK_OVERLAP=200
GRAPHRAG_INGESTION_MAX_FILE_SIZE_BYTES=52428800

# Runtime integration mode used when launching the GraphRAG Fuseki server.
GRAPHRAG_SERVER_MODE=library
