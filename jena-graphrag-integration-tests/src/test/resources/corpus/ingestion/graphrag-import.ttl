@prefix grag: <http://ormynet.com/ns/msft-graphrag#> .
@prefix corpus: <https://jena.apache.org/graphrag/integration/corpus/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

corpus:document-import a grag:Document ;
    grag:id "document-import" ;
    grag:title "Importer integration fixture" .

corpus:chunk-import a grag:Chunk ;
    grag:id "chunk-import" ;
    grag:n_tokens 8 ;
    grag:text "Alpha collaborates with Beta." ;
    grag:part_of corpus:document-import .

corpus:alpha a grag:Entity ;
    grag:id "entity-alpha" ;
    grag:name "Alpha" ;
    grag:has_entity corpus:chunk-import ;
    dcterms:source "integration fixture" .

corpus:beta a grag:Entity ;
    grag:id "entity-beta" ;
    grag:name "Beta" .

corpus:related_to_alpha_beta a grag:related_to ;
    grag:id "relationship-alpha-beta" ;
    grag:description "Alpha collaborates with Beta." ;
    grag:weight 1.0 .

corpus:alpha corpus:related_to_alpha_beta corpus:beta .