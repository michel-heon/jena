# Local GraphRAG runtime configuration. Created as env/.env by bootstrap and ignored by Git.
GRAPHRAG_EMBEDDING_API_URL=
GRAPHRAG_EMBEDDING_API_KEY=
GRAPHRAG_EMBEDDING_MODEL=
GRAPHRAG_EMBEDDING_DIMENSION=
GRAPHRAG_DEFAULT_MODE=local
GRAPHRAG_DEFAULT_TOP_K=5
GRAPHRAG_MAX_TOP_K=100
GRAPHRAG_INDEX_MAX_CONTENT_LENGTH=1000000
GRAPHRAG_TUTORIAL_PDF_PATH=src/test/resources/corpus/ingestion/pdf
GRAPHRAG_TUTORIAL_CORPUS_PATH=target/tranche-7-tutoriel/pdf-corpus.ttl
GRAPHRAG_TUTORIAL_DATASET=graphrag-smoke
GRAPHRAG_TUTORIAL_EXPECTED_PDF_COUNT=12
GRAPHRAG_INGESTION_BASE_URI=http://ormynet.com/ns/data#
GRAPHRAG_INGESTION_CHUNK_SIZE=1000
GRAPHRAG_INGESTION_CHUNK_OVERLAP=200
GRAPHRAG_INGESTION_MAX_FILE_SIZE_BYTES=52428800
GRAPHRAG_SERVER_MODE=library